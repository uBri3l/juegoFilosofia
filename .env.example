# ============================================================================
# CONFIGURACIÓN DE PROVEEDORES DE LLM GRATUITOS PARA LITELLM
# Copia este archivo como `.env` y pega las claves gratuitas que quieras usar.
# El Router de LiteLLM probará automáticamente en orden de prioridad y cambiará
# al siguiente proveedor gratis si uno alcanza su límite por minuto.
# ============================================================================

# 1. GROQ (Recomendado #1 - Ultra rápido, Llama 3.3 70B gratis sin tarjeta)
# Consíguela en 30 seg: https://console.groq.com/keys
GROQ_API_KEY=

# 2. GOOGLE AI STUDIO / GEMINI (Recomendado #2 - Gemini 2.5 Flash gratis sin tarjeta)
# Consíguela en 30 seg: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OPENROUTER (Recomendado #3 - Decenas de modelos `:free` con una sola cuenta)
# Consíguela en 30 seg: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 4. CEREBRAS INFERENCE (Opcional - Llama 3.3 70B gratis a 2000 tokens/seg)
# Consíguela en: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# 5. MISTRAL AI LA PLATEFORME (Opcional - Plan Experiment gratuito)
# Consíguela en: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# 6. GITHUB MODELS (Opcional - Usa tu token de GitHub para GPT-4o-mini / Llama 3.3 gratis)
# Si ya iniciaste sesión con GitHub CLI (`gh`), nuestro backend puede detectarlo automáticamente
GITHUB_API_KEY=

# 7. OLLAMA LOCAL (Opcional - 100% offline en tu PC si instalas https://ollama.com)
OLLAMA_API_BASE=http://localhost:11434
